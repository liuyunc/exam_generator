# ========= 必需配置 =========
# API 密钥（必须设置）
GPUSTACK_API_KEY=your_api_key_here

# API 基础 URL（必须设置）
GPUSTACK_BASE_URL=https://api.deepseek.com/v1

# ========= 可选配置 =========
# 模型名称（默认：deepseek-r1）
DEEPSEEK_MODEL_NAME=deepseek-r1

# API 超时时间（秒，范围：10-600，默认：120）
GPUSTACK_TIMEOUT=120

# 最大重试次数（范围：1-5，默认：2）
GPUSTACK_MAX_RETRIES=2

# CORS 允许的来源（逗号分隔，默认：http://localhost:3000,http://localhost:8000）
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ========= 可选的旧变量（兼容性） =========
# DEEPSEEK_API_KEY=your_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
